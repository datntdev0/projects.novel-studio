{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": { "analytics": false },
  "projects": {
    "angular": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": { "base": "../dist/app/renderer", "browser": "" },
            "baseHref": "./",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "styles": ["src/styles.scss"],
            "stylePreprocessorOptions": { "sass": { "silenceDeprecations": ["import"] } },
            "loader": { ".svg": "text" },
            "assets": [
              { "glob": "**/*", "input": "public" },
              { "glob": "OFL-*.txt", "input": "src/assets/fonts", "output": "licenses" },
              { "glob": "LICENSE", "input": "node_modules/bootstrap", "output": "licenses/bootstrap" }
            ]
          },
          "configurations": {
            "production": {
              "baseHref": "index.html",
              "outputHashing": "all",
              "optimization": { "scripts": true, "styles": { "minify": true, "inlineCritical": false }, "fonts": false }
            },
            "development": { "optimization": false, "sourceMap": true, "extractLicenses": false },
            "e2e": {
              "optimization": false,
              "sourceMap": true,
              "extractLicenses": false,
              "fileReplacements": [
                { "replace": "src/app/core/bridge/bridge.provider.ts", "with": "src/app/core/bridge/bridge.provider.e2e.ts" }
              ]
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": { "e2e": { "buildTarget": "angular:build:e2e", "watch": false, "liveReload": false, "hmr": false } }
        },
        "storybook": {
          "builder": "@storybook/angular:start-storybook",
          "options": {
            "configDir": ".storybook",
            "browserTarget": "angular:build:development",
            "tsConfig": ".storybook/tsconfig.json",
            "compodoc": false,
            "experimentalZoneless": true,
            "styles": ["src/styles.scss"],
            "port": 6006
          }
        },
        "build-storybook": {
          "builder": "@storybook/angular:build-storybook",
          "options": {
            "configDir": ".storybook",
            "browserTarget": "angular:build:development",
            "tsConfig": ".storybook/tsconfig.json",
            "compodoc": false,
            "experimentalZoneless": true,
            "styles": ["src/styles.scss"],
            "outputDir": "../dist/storybook"
          }
        }
      }
    }
  }
}
