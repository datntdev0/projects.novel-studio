{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": { "analytics": false },
  "projects": {
    "angular": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": { "base": "../dist/app/renderer", "browser": "" },
            "baseHref": "",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "styles": ["src/styles.scss"],
            "stylePreprocessorOptions": { "sass": { "silenceDeprecations": ["import"] } },
            "loader": { ".svg": "text" },
            "assets": [
              { "glob": "**/*", "input": "public" },
              { "glob": "OFL-*.txt", "input": "src/assets/fonts", "output": "licenses" },
              { "glob": "LICENSE", "input": "node_modules/bootstrap", "output": "licenses/bootstrap" }
            ]
          },
          "configurations": {
            "production": {
              "outputHashing": "all",
              "optimization": { "scripts": true, "styles": { "minify": true, "inlineCritical": false }, "fonts": false }
            },
            "development": {
              "optimization": false,
              "sourceMap": true,
              "extractLicenses": false,
              "fileReplacements": [{ "replace": "src/app/dev/dev.routes.ts", "with": "src/app/dev/dev.routes.dev.ts" }]
            },
            "e2e": {
              "optimization": false,
              "sourceMap": true,
              "extractLicenses": false,
              "fileReplacements": [
                { "replace": "src/app/core/bridge/bridge.provider.ts", "with": "src/app/core/bridge/bridge.provider.e2e.ts" },
                { "replace": "src/app/dev/dev.routes.ts", "with": "src/app/dev/dev.routes.dev.ts" }
              ]
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "development": { "buildTarget": "angular:build:development" },
            "e2e": { "buildTarget": "angular:build:e2e", "watch": false, "liveReload": false, "hmr": false }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  }
}
