{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": { "analytics": false },
  "projects": {
    "angular": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": { "base": "../dist/app/renderer", "browser": "" },
            "baseHref": "./",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "styles": ["src/styles.scss"],
            "assets": [{ "glob": "**/*", "input": "public" }]
          },
          "configurations": {
            "production": {
              "outputHashing": "all",
              "optimization": { "scripts": true, "styles": { "minify": true, "inlineCritical": false }, "fonts": false }
            },
            "development": { "optimization": false, "sourceMap": true, "extractLicenses": false },
            "e2e": {
              "optimization": false,
              "sourceMap": true,
              "extractLicenses": false,
              "fileReplacements": [
                { "replace": "src/app/core/bridge/bridge.provider.ts", "with": "src/app/core/bridge/bridge.provider.e2e.ts" }
              ]
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": { "e2e": { "buildTarget": "angular:build:e2e", "watch": false, "liveReload": false, "hmr": false } }
        }
      }
    }
  }
}
